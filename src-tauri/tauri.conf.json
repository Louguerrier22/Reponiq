{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reponiq",
  "version": "1.2.0",
  "identifier": "dev.reponiq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reponiq",
        "width": 1370,
        "height": 870,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3MEQ2Qjc3NTc4NzlBMkMKUldRc21vZFhkMnNORjRtcjV3MnZtZ0ZuTGJwa2VXS3YwblFnUW81ZHFHWTNDVU5nY3RZak5qTTEK",
      "endpoints": ["https://github.com/Louguerrier22/Reponiq/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/reponiq/fontconfig.conf": "../assets/fontconfig/reponiq.conf"
        }
      }
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Your repositories, beautifully in focus.",
    "longDescription": "A local-first native Git and GitHub workspace. Organize repositories, review changes, commit, and monitor GitHub Actions.",
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": [
      "../THIRD_PARTY_NOTICES.txt",
      "../LICENSE"
    ]
  }
}
